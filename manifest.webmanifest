{
  "name": "SumanImg Studio",
  "short_name": "SumanImg Studio",
  "description": "Private, browser-native viewer and converter for the SumanImg image format.",
  "id": "/my-custom-formats/",
  "start_url": "/my-custom-formats/",
  "scope": "/my-custom-formats/",
  "display": "standalone",
  "background_color": "#070b16",
  "theme_color": "#0b1020",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/my-custom-formats/",
      "accept": {
        "image/x-sumanimg": [".sumanImg"]
      },
      "launch_type": "single-client"
    }
  ]
}
